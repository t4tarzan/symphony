# =============================================================================
# Symphony + LiteLLM Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
#
# NEVER commit .env to version control.
# =============================================================================

# =============================================================================
# === OpenAI (Primary) ===
# =============================================================================

# Your OpenAI API key — used by Codex for all coding tasks
OPENAI_API_KEY=sk-...

# ---- Proxy mode vs Direct mode ----
#
# DIRECT MODE (Codex -> OpenAI api.openai.com directly):
#   Comment out OPENAI_BASE_URL below. Codex will talk directly to OpenAI.
#   Simpler setup but no automatic OpenRouter fallback.
#
# PROXY MODE (Codex -> LiteLLM -> OpenAI primary / OpenRouter fallback):
#   Uncomment OPENAI_BASE_URL below. Codex will send all requests through
#   the LiteLLM container which handles failover automatically.
#
# OPENAI_BASE_URL=http://litellm:4000/v1

# =============================================================================
# === OpenRouter (Fallback — only needed in proxy mode) ===
# =============================================================================

# OpenRouter API key — used by LiteLLM when OpenAI primary fails
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# =============================================================================
# === Linear (Issue Tracker) ===
# =============================================================================

# Linear personal API key
# Generate at: Linear Settings → Security & access → Personal API keys
LINEAR_API_KEY=lin_api_...

# =============================================================================
# === GitHub ===
# =============================================================================

# GitHub Personal Access Token (classic) or Fine-Grained PAT
# Needs: repo (read/write), workflow (if using Actions)
GH_TOKEN=ghp_...
GITHUB_TOKEN=ghp_...

# =============================================================================
# === LiteLLM Proxy ===
# =============================================================================

# Master key for authenticating requests to the LiteLLM proxy
# Generate a random string: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-...

# =============================================================================
# === Symphony ===
# =============================================================================

# Where Codex agent workspaces are created (mapped to ./workspaces volume)
SYMPHONY_WORKSPACE_ROOT=/home/symphony/workspaces

# =============================================================================
# === Repository (used in WORKFLOW.md hooks) ===
# =============================================================================

# GitHub org or username that owns the repo agents will work in
REPO_OWNER=t4tarzan

# Repository name that agents will clone and work in
REPO_NAME=your-repo-name
